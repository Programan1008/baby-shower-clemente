rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /confirmaciones/{confirmacionId} {
      // La web pública puede crear una confirmación con campos controlados.
      allow create: if
        request.resource.data.keys().hasOnly([
          'nombre',
          'asistencia',
          'creadoEn',
          'actualizadoEn'
        ]) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 2 &&
        request.resource.data.nombre.size() <= 80 &&
        request.resource.data.asistencia is bool;

      // Permite modificar el mismo documento desde el navegador que conoce su ID.
      // No permite cambiar el timestamp original de creación.
      allow update: if
        request.resource.data.keys().hasOnly([
          'nombre',
          'asistencia',
          'creadoEn',
          'actualizadoEn'
        ]) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 2 &&
        request.resource.data.nombre.size() <= 80 &&
        request.resource.data.asistencia is bool &&
        request.resource.data.creadoEn == resource.data.creadoEn;

      // La invitación pública no necesita leer ni listar las confirmaciones.
      allow read, delete: if false;
    }
  }
}
